# Keep only the small public catalog fallback in Android assets; the backend owns the content copy.
/GateApp/app/src/main/assets/images/
/GateApp/app/src/main/assets/data/q/
/GateApp/app/src/main/assets/data/mock/mock_*.json

# Local captures and temporary tooling output
*.apk
*.aab
