# Copy to .env and fill in. .env is git-ignored and read automatically at start-up.

# --- database (production / AWS RDS). Not needed with --spring.profiles.active=dev (embedded Postgres)
DB_URL=jdbc:postgresql://localhost:5432/gate
DB_USER=gate
DB_PASSWORD=change-me
DB_POOL_SIZE=10

# --- auth: at least 32 characters, random. Generate one:  openssl rand -base64 48
JWT_SECRET=

# --- image storage: "local" (files in ./content/images) or "s3"
STORAGE_TYPE=local
CONTENT_DIR=./content

# --- AWS (only needed when STORAGE_TYPE=s3). Add these last.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
S3_BUCKET=
# set to true once to upload ./content/images to the bucket
S3_SYNC_ON_START=false
