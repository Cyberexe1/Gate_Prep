* text=auto

# Stable line endings across Windows and CI
*.bat text eol=crlf
*.sh text eol=lf
*.kt text eol=lf
*.kts text eol=lf
*.java text eol=lf
*.py text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.xml text eol=lf
*.json text eol=lf
*.sql text eol=lf
*.properties text eol=lf

# Binary assets
*.jar binary
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.pdf binary
